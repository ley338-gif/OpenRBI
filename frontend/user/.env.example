# Compact (default): the User Portal is proxied to the same origin as the
# reverse proxy's /api/ location (both-mode backend). Copy to .env only if
# you need to override it — Segmented deployments point this at the
# User API's own origin instead, e.g. https://browser.openrbi.local/api
# (see docs/deployment.md#compact-vs-segmented-productization-v011).
VITE_API_BASE_URL=/api
