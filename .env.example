# Copy to .env and fill in real values. Never commit .env.
# Fail-closed principle: services refuse to start with missing/empty secrets
# rather than falling back to an insecure default. As of Phase 20, this is
# enforced in code, not just documented here: backend/app/config.py and
# session-agent/app/config.py reject any of the secret fields below at
# startup if it's empty OR still the literal "changeme-generate-a-strong-
# secret" placeholder text — copying this file to .env without editing the
# secrets will not silently start.

# --- PostgreSQL ---
POSTGRES_USER=openrbi
POSTGRES_PASSWORD=changeme-generate-a-strong-secret
POSTGRES_DB=openrbi

# --- Backend ---
# Set to "production" for any real deployment — this flips the session
# cookie to Secure (HTTPS-only). See docs/adr/0008-fail-closed.md.
OPENRBI_ENVIRONMENT=development
OPENRBI_DATABASE_URL=postgresql+asyncpg://openrbi:changeme-generate-a-strong-secret@postgres:5432/openrbi
OPENRBI_REDIS_URL=redis://redis:6379/0
OPENRBI_SESSION_AGENT_BASE_URL=http://session-agent:8100
# Shared secret between backend and session-agent — generate with:
#   openssl rand -hex 32
OPENRBI_SESSION_AGENT_API_TOKEN=changeme-generate-a-strong-secret
# Encryption key for TOTP secrets at rest — generate with:
#   openssl rand -hex 32
OPENRBI_TOTP_SECRET_ENCRYPTION_KEY=changeme-generate-a-strong-secret
# Which API surface this backend process registers — "both" (default)
# reproduces MVP 1's exact prior behavior and is correct for Compact/
# homelab/dev deployments; leave this unset/commented out. "user"/"admin"
# are for a Segmented deployment running two instances of the same image
# — see docs/deployment.md and docs/adr/0011-user-admin-listener-separation.md.
# Any other value fails startup immediately, it is not silently ignored.
# OPENRBI_LISTENER_MODE=both

# --- Session Agent ---
OPENRBI_AGENT_API_TOKEN=changeme-generate-a-strong-secret
# Stable node identity for the BrowserNode row — deliberately NOT the
# container's own hostname (ephemeral, changes on every recreation; see
# CHANGELOG "Fixed" for the bug this caused). In a real multi-node
# deployment, give each node's agent its own distinct, stable name here.
OPENRBI_AGENT_NODE_NAME=default-node
