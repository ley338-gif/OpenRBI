# Copy to .env and fill in real values. Never commit .env.
# Fail-closed principle: services refuse to start with missing/empty secrets
# rather than falling back to an insecure default. As of Phase 20, this is
# enforced in code, not just documented here: backend/app/config.py and
# session-agent/app/config.py reject any of the secret fields below at
# startup if it's empty OR still the literal "changeme-generate-a-strong-
# secret" placeholder text — copying this file to .env without editing the
# secrets will not silently start.

# --- PostgreSQL ---
POSTGRES_USER=openrbi
POSTGRES_PASSWORD=changeme-generate-a-strong-secret
POSTGRES_DB=openrbi

# --- Backend ---
# Set to "production" for any real deployment — this flips the session
# cookie to Secure (HTTPS-only). See docs/adr/0008-fail-closed.md.
OPENRBI_ENVIRONMENT=development
OPENRBI_DATABASE_URL=postgresql+asyncpg://openrbi:changeme-generate-a-strong-secret@postgres:5432/openrbi
OPENRBI_REDIS_URL=redis://redis:6379/0
# Console-issued first-run token lifetime (default: 30 minutes). Restart
# the backend before initialization to invalidate it and issue a fresh one.
# OPENRBI_SETUP_TOKEN_TTL_SECONDS=1800
OPENRBI_SESSION_AGENT_BASE_URL=http://session-agent:8100
# Shared secret between backend and session-agent — generate with:
#   openssl rand -hex 32
OPENRBI_SESSION_AGENT_API_TOKEN=changeme-generate-a-strong-secret
# Encryption key for TOTP secrets at rest — generate with:
#   openssl rand -hex 32
OPENRBI_TOTP_SECRET_ENCRYPTION_KEY=changeme-generate-a-strong-secret
# Signs the CSRF double-submit cookie (RBI-POST-003, app/core/csrf.py) —
# generate with:
#   openssl rand -hex 32
OPENRBI_CSRF_SECRET_KEY=changeme-generate-a-strong-secret
# Which API surface this backend process registers — "both" (default)
# reproduces MVP 1's exact prior behavior and is correct for Compact/
# homelab/dev deployments; leave this unset/commented out. "user"/"admin"
# are for a Segmented deployment running two instances of the same image
# — see docs/deployment.md and docs/adr/0011-user-admin-listener-separation.md.
# Any other value fails startup immediately, it is not silently ignored.
# OPENRBI_LISTENER_MODE=both

# --- Network isolation health check (RBI-POST-002, docs/deployment.md
# #network-isolation) ---
# Where the backend reads scripts/setup-network-isolation.sh's marker file
# from *inside the container* — matches docker-compose.yml's read-only
# bind mount by default; only change this if you changed that mount too.
# OPENRBI_NETWORK_ISOLATION_MARKER_FILE=/etc/openrbi/network-isolation/marker
# How old that marker may be before the network_isolation health component
# drops from HEALTHY to DEGRADED. Keep comfortably above
# scripts/systemd/openrbi-network-isolation.timer's rerun interval (5min).
# OPENRBI_NETWORK_ISOLATION_MAX_STALENESS_SECONDS=900

# --- LDAP/LDAPS authentication (Roadmap Phase B / B1, docs/adr/0015) ---
# Optional, disabled by default. An equal, parallel login option alongside
# local accounts, never a replacement — local login stays available even
# with LDAP enabled (and is the only option during an LDAP outage: LDAP
# failures are fail-closed, never a silent fallback to "allow").
# OPENRBI_LDAP_ENABLED=true
#
# Must start with ldaps:// (recommended) or ldap:// with StartTLS left on
# (the default). A plain ldap:// URI with OPENRBI_LDAP_USE_STARTTLS=false
# is refused at startup — there is no supported way to configure an
# unencrypted bind.
# OPENRBI_LDAP_SERVER_URI=ldaps://ad.example.org:636
# OPENRBI_LDAP_USE_STARTTLS=true
#
# A dedicated search/bind service account (not an admin's own credentials)
# used only to locate a user's DN before attempting the real bind-as-user
# that actually verifies their password. Generate a real password however
# your AD environment normally provisions service accounts.
# OPENRBI_LDAP_BIND_DN=CN=openrbi-search,OU=ServiceAccounts,DC=example,DC=org
OPENRBI_LDAP_BIND_PASSWORD=changeme-generate-a-strong-secret
# OPENRBI_LDAP_BASE_DN=DC=example,DC=org
#
# {username} is substituted with the value typed at login (escaped against
# LDAP filter injection, never interpolated raw). sAMAccountName is the AD
# default; adjust for a non-AD LDAP directory (e.g. uid=... for OpenLDAP).
# OPENRBI_LDAP_USER_SEARCH_FILTER=(sAMAccountName={username})
# OPENRBI_LDAP_GROUP_ATTRIBUTE=memberOf
#
# Certificate verification is always enforced (OPT_X_TLS_REQUIRE_CERT=
# demand, backend/app/core/auth_providers/ldap.py) — there is no setting
# that disables it. If the directory's LDAPS certificate is issued by an
# internal/private CA rather than a public one already in the container's
# OS trust store, mount that CA's PEM bundle read-only into the backend
# container (see docker-compose.yml's commented-out example) and point
# this at the mounted path. Leave unset to trust only the OS store (public
# CAs). See docs/deployment.md "LDAP TLS trust" for public-CA/internal-CA/
# cert-rotation/troubleshooting guidance.
# OPENRBI_LDAP_CA_CERT_FILE=/etc/openrbi/ldap-ca.pem

# --- Session Agent ---
# REQUIRED on every real host — docker-compose.yml refuses to start
# session-agent at all without this set (left commented out here
# deliberately, so that refusal is what actually happens if you forget
# this step, rather than silently using a wrong value). session-agent
# runs as a non-root user and needs this to actually reach
# /var/run/docker.sock (found on real infrastructure: docker.sock is
# normally root:<docker-group> mode 660, and that group's GID is
# host-specific, essentially never 0). Determine it with:
#   stat -c '%g' /var/run/docker.sock
# OPENRBI_DOCKER_SOCKET_GID=999

OPENRBI_AGENT_API_TOKEN=changeme-generate-a-strong-secret
# Stable node identity for the BrowserNode row — deliberately NOT the
# container's own hostname (ephemeral, changes on every recreation; see
# CHANGELOG "Fixed" for the bug this caused). In a real multi-node
# deployment, give each node's agent its own distinct, stable name here.
OPENRBI_AGENT_NODE_NAME=default-node

# Roadmap B2.1 (docs/adr/0023-node-enrollment-and-trust-model.md) — only
# needed when adding a second/Nth node to an existing deployment. Leave
# both commented out for the default single-node case (unchanged from
# today). Generate an enrollment token via an ADMIN session:
#   POST /admin/nodes/enrollment-tokens
# then set it here, along with a real generated OPENRBI_AGENT_API_TOKEN
# above (distinct per node, never reused across nodes), before starting
# this agent — it registers itself once at startup and awaits an admin's
# approval in the Admin Portal.
# OPENRBI_AGENT_ENROLLMENT_TOKEN=
# OPENRBI_AGENT_CONTROL_PLANE_URL=http://backend:8000

# Roadmap B2.3 — how many concurrent sandboxes this node's agent will
# accept before select_node() treats it as full. 10 matches the previous
# hardcoded default exactly; only worth changing once you know this
# host's real headroom (host-resource-aware auto-sizing is out of scope
# for B2 — see docs/roadmap-b2-multinode.md).
# OPENRBI_AGENT_CAPACITY=10

# Roadmap B2.4 (docs/adr/0024-cross-host-display-relay.md) — docker-compose.yml
# variables (read at `docker compose up` time, not by any application
# Settings() class), so they belong at the host/.env level like
# OPENRBI_DOCKER_SOCKET_GID above, not inside a container. Only worth
# setting on a second/Nth host whose own browser-plane subnet would
# otherwise collide with another node's (see docs/roadmap-b2-multinode.md);
# leave both commented out for the default single-node case.
# OPENRBI_BROWSER_PLANE_SUBNET=172.30.1.0/24
# OPENRBI_AGENT_BROWSER_PLANE_IP=172.30.1.2
