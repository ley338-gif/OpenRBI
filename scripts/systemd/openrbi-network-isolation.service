# RBI-POST-002: re-applies scripts/setup-network-isolation.sh's DOCKER-USER
# iptables blocklist and refreshes its marker file (read by the backend's
# /admin health check, app/services/health.py::check_network_isolation).
#
# Install (as root, on the Docker host) with the helper, which writes this
# unit with WorkingDirectory set to the checkout's real path, enables the
# timer, and runs the service once — failing loudly if that run fails:
#   sudo ./scripts/install-network-isolation-timer.sh
#
# If you copy this file into /etc/systemd/system/ by hand instead, you MUST
# set WorkingDirectory below to the exact (case-sensitive) path of your
# checkout. A mismatch fails every run with status=200/CHDIR while the
# timer itself keeps reporting "active (waiting)" — check
# `systemctl status openrbi-network-isolation.service`, not just
# `systemctl list-timers`. This unit is deliberately not started
# automatically by anything OpenRBI ships — installing it is an explicit
# host-admin step (docs/deployment.md#network-isolation).
[Unit]
Description=OpenRBI browser-plane network isolation (iptables)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/OpenRBI
ExecStart=/bin/sh scripts/setup-network-isolation.sh
