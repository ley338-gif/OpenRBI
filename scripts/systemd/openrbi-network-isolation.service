# RBI-POST-002: re-applies scripts/setup-network-isolation.sh's DOCKER-USER
# iptables blocklist and refreshes its marker file (read by the backend's
# /admin health check, app/services/health.py::check_network_isolation).
#
# Install (as root, on the Docker host):
#   cp scripts/systemd/openrbi-network-isolation.service /etc/systemd/system/
#   cp scripts/systemd/openrbi-network-isolation.timer /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now openrbi-network-isolation.timer
#   systemctl start openrbi-network-isolation.service   # apply once immediately
#
# Adjust WorkingDirectory below to wherever this repository is checked out
# on the host. This unit is deliberately not started automatically by
# anything OpenRBI ships — installing it is an explicit host-admin step,
# same as running the script manually was before this existed (docs/
# deployment.md#network-isolation).
[Unit]
Description=OpenRBI browser-plane network isolation (iptables)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/openrbi
ExecStart=/bin/sh scripts/setup-network-isolation.sh
